<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- background (unfilled track) -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <size android:height="6dp"/>
            <solid android:color="#33000000"/> <!-- translucent dark -->
            <corners android:radius="4dp"/>
        </shape>
    </item>

    <!-- progress (filled part) -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="6dp"/>
                <solid android:color="#FF9500"/> <!-- orange progress -->
                <corners android:radius="4dp"/>
            </shape>
        </clip>
    </item>

    <!-- secondary progress (optional) -->
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="6dp"/>
                <solid android:color="#FFB580"/> <!-- lighter orange if used -->
                <corners android:radius="4dp"/>
            </shape>
        </clip>
    </item>
</layer-list>