<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0E17"
    android:id="@+id/main"
    tools:context=".dashboard">

    <!-- Scrollable content (your UI) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top row: wifi + actions -->
            <LinearLayout
                android:layout_marginTop="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/wifiLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:padding="5dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivWifiStatus"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_wifi" />

                    <TextView
                        android:id="@+id/tvWifiStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="1dp"
                        android:paddingStart="6dp"
                        android:text="Wi-Fi Connected"
                        android:textColor="#00FF88"
                        android:textSize="12sp" />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="5dp">

                    <ImageView
                        android:id="@+id/ivShare"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_toLeftOf="@id/btnSetting"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="26dp"
                        android:src="@drawable/share" />

                    <ImageView
                        android:id="@+id/btnSetting"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/setting" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Connect / Browser Mirroring row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:layout_marginTop="50dp">

                <RelativeLayout
                    android:id="@+id/backorange"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/circle_orange"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/imgconnect"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_cast"
                        app:tint="#F4EDED" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    android:layout_below="@id/backorange"
                    android:layout_marginStart="35dp"
                    />

                <RelativeLayout
                    android:id="@+id/backglobal"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/circle_teal"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_globe"
                        app:tint="#F4EDED" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Browser Mirroring"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    android:layout_below="@id/backglobal"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="6dp" />
            </RelativeLayout>

            <!-- Tutorial & Floating Tools block -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:layout_gravity="center">

                <Button
                    android:id="@+id/btnTutorial"
                    android:layout_width="160dp"
                    android:layout_height="70dp"
                    android:layout_alignParentStart="true"
                    android:backgroundTint="#1F2A5C"
                    android:text="Tutorial &amp; FAQ"
                    android:textColor="@android:color/white" />

                <LinearLayout
                    android:id="@+id/layoutFloatingTools"
                    android:layout_width="160dp"
                    android:layout_height="60dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="6dp"
                    android:background="#1F2A5C"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:text="Floating tools"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <Switch

                        android:id="@+id/switch_overlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Add more content below as needed; ScrollView will make content scrollable -->

        </LinearLayout>
    </ScrollView>

    <!-- OVERLAY: three curved lines at top-right -->
    <ImageView
        android:id="@+id/topRightCurves"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/curved_lines"
        android:contentDescription="Decorative curved lines"
        android:importantForAccessibility="no" />

</FrameLayout>
