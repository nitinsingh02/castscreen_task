<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E1F"
    android:orientation="vertical"
    tools:context=".browserMirroring">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/backimg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="5dp"
        android:layout_marginTop="7dp"
        android:src="@drawable/baseline_arrow_back_ios_24"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Browser Mirroring"
        android:textSize="25sp"
        android:layout_marginTop="8dp"
        android:textStyle="bold"
        android:textColor="@color/white"/>

</LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D32F2F">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_centerInParent="true"
            android:text="Don't leave this page before connected."/>


    </RelativeLayout>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="120dp"
            android:src="@drawable/screen"
            android:contentDescription="Mirror Illustration"
            android:layout_gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wi-Fi A"
            android:textColor="#00FFAA"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:gravity="center"/>
    </LinearLayout>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Connect to the same Wi-Fi and turn off VPN."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="10dp"/>

        <!-- Wi-Fi Status -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="#222222"
            android:padding="10dp"
            android:layout_marginHorizontal="4dp"
            android:layout_gravity="center_vertical"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:elevation="2dp"
            android:backgroundTint="#222222"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/broWifi"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_wifi"
                android:backgroundTint="#00FF88"/>

            <TextView
                android:id="@+id/broWifiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi: Wi-Fi Connected"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingStart="8dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Open this website on the other device:"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <!-- URL Box -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#222222"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvIpAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="http://0.0.0.0:5621"
                android:textColor="#FFAA33"
                android:textSize="14sp"
                android:singleLine="true"/>

            <ImageView
                android:id="@+id/ivCopy"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_copy"
                />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The IP address may change every time you connect. Please make sure each number is entered correctly in the browser address bar."
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"/>
    </LinearLayout>


    </LinearLayout>